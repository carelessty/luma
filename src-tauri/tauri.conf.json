{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luma",
  "version": "0.1.0",
  "identifier": "io.luma.emby",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Luma · Emby",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 650,
        "decorations": true,
        "backgroundColor": "#111213",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http: https: data: blob:; media-src 'self' http: https: blob:; connect-src ipc: http: https:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Your cinema, beautifully connected.",
    "longDescription": "Luma is an independent Emby client powered by Rust. Browse your library, discover something to watch, and pick up exactly where you left off.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
